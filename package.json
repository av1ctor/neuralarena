    "@vitejs/plugin-react": "^4.2.1",
    "assert": "2.0.0",
    "buffer": "6.0.3",
    "dotenv": "^16.0.3",
    "events": "3.3.0",
    "process": "0.11.10",
    "stream-browserify": "3.0.0",
