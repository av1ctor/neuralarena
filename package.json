{
  "name": "site",
  "version": "0.0.1",
  "type": "module",
  "description": "NeuralArena site",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prebuild": "dfx generate",
    "deploy:local": "dfx deploy --network=local",
    "deploy:ic": "dfx deploy --network=ic",
    "deploy:backend:dev": "dfx deploy main && npm run extract && npm run generate",
    "extract": "candid-extractor target/wasm32-unknown-unknown/release/main.wasm >./src/main/main.did",
    "generate": "dfx generate main"
  },
  "dependencies": {
    "@dfinity/agent": "^0.19.3",
