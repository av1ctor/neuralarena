type MatchJoinRequest = record { id : text; name : text };
type MatchOptions = record {
  fov : float32;
  fps : float32;
  tps : float32;
  min_players : nat64;
  rays : nat64;
  num_hidden_layers : nat64;
  max_players : nat64;
  epsilon : float64;
  player_radius : float32;
  map_name : text;
};
type MatchRequest = record { options : MatchOptions };
type MatchResponse = record { id : text };
type MatchStep = record {
  terminated : bool;
  winner : opt nat64;
  entities : vec nat8;
  timedout : bool;
};
type MatchStepsRequest = record { id : text; pag : Pagination };
type MatchStepsResponse = record { steps : vec MatchStep };
type Pagination = record { offset : nat32; limit : nat32 };
type Result = variant { Ok : MatchResponse; Err : text };
type Result_1 = variant { Ok : MatchStepsResponse; Err : text };
type Result_2 = variant { Ok; Err : text };
type Result_3 = variant { Ok : UserResponse; Err : text };
type Result_4 = variant { Ok : vec MatchResponse; Err : text };
type StaffRequest = record { role : StaffRole };
type StaffRole = variant { Member; Admin; Contributor };
type UserKindRequest = variant { Staff : StaffRequest; Player : record {} };
type UserRequest = record { kind : UserKindRequest; name : text; email : text };
type UserResponse = record {
  id : principal;
  updated_at : opt nat64;
  active : bool;
  kind : UserKindRequest;
  name : text;
  banned : bool;
  created_at : nat64;
  email : text;
};
service : () -> {
  match_create : (MatchRequest) -> (Result);
  match_get_steps : (MatchStepsRequest) -> (Result_1) query;
  match_join : (MatchJoinRequest) -> (Result_2);
  match_run : (MatchResponse) -> (Result_2);
  match_start : (MatchResponse) -> (Result_2);
  user_create : (UserRequest) -> (Result_3);
  user_delete : (principal) -> (Result_2);
  user_find_by_id : (principal) -> (Result_3) query;
  user_find_matches : (principal, Pagination) -> (Result_4) query;
  user_find_me : () -> (Result_3) query;
  user_update : (principal, UserRequest) -> (Result_3);
}
