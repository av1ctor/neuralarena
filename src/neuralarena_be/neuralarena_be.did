type Asset = record { typ : AssetType; data : vec record { text; AssetValue } };
type AssetType = variant { Map; Npc; Object; Player };
type AssetValue = variant {
  F32 : float32;
  Map : HashMap_1;
  U32 : nat32;
  Vec : vec AssetValue;
  Bool : bool;
  None;
  Text : text;
};
type DeveloperRequest = record { url : opt text };
type GameCost = variant { ICP : nat; USD : nat64 };
type GameCosts = record { to_play : GameCost };
type GameEndCredits = record {
  sub : vec GameEndCredits;
  title : text;
  people : vec record { text; text };
};
type GameInfo = record {
  fps : nat32;
  states : vec text;
  min_players : nat64;
  sfx_sets : vec vec record { text; GameSfx };
  maps : vec GameMap;
  name : text;
  costs : GameCosts;
  urls : GameURLs;
  description : text;
  max_players : nat64;
  version : float32;
  category : text;
  skills : vec text;
};
type GameMap = record {
  id : nat64;
  name : text;
  urls : GameMapUrls;
  description : text;
  version : float32;
};
type GameMapUrls = record { model : text; music : text; image : text };
type GameRequest = record { canister_id : principal };
type GameResponse = record {
  id : text;
  info : GameInfo;
  canister_id : principal;
};
type GameSceneURLs = record { model : text; music : opt text };
type GameSfx = record {
  url : text;
  repeat : bool;
  rate : opt float32;
  detune : opt float32;
};
type GameURLs = record {
  engine_wasm : text;
  scenes : vec record { text; GameSceneURLs };
  cover : text;
  assets : text;
};
type HashMap = vec record {
  text;
  variant {
    Int : int;
    Map : HashMap;
    Nat : nat;
    Blob : vec nat8;
    Text : text;
    Double : float64;
    Float : float32;
    Array : vec Nas1Value;
  };
};
type HashMap_1 = vec record {
  text;
  variant {
    F32 : float32;
    Map : HashMap_1;
    U32 : nat32;
    Vec : vec AssetValue;
    Bool : bool;
    None;
    Text : text;
  };
};
type InitArg = record { icp_ledger_canister_id : principal };
type InstanceAssetsResponse = record { assets : vec record { nat64; Asset } };
type InstanceRunSlice = record { seed : nat64; first_step : nat64 };
type InstanceStep = record { entities : vec nat8; events : vec nat8 };
type InstanceStepsResponse = record { steps : vec InstanceStep };
type MatchGame = record {
  id : text;
  min_players : nat64;
  max_players : nat64;
  max_steps : nat64;
  map_id : nat64;
  options : vec record { text; text };
};
type MatchJoinRequest = record { id : text; nft : UserNftRequest };
type MatchPlayerNftResponse = record {
  token_id : nat;
  collection_id : principal;
  props : Nas1Token;
};
type MatchPlayerResponse = record {
  id : principal;
  nft : MatchPlayerNftResponse;
  score : float32;
  health : float32;
};
type MatchRequest = record { game : MatchGame; deadline : nat64 };
type MatchResponse = record {
  id : text;
  game : MatchGame;
  deadline : nat64;
  created_at : nat64;
  created_by : principal;
  state : MatchStateResponse;
  players : vec MatchPlayerResponse;
  won_at : opt nat64;
  won_by : opt principal;
  started_at : opt nat64;
};
type MatchStateResponse = record {
  status : MatchStatus;
  initial_seed : opt nat64;
  run_slices : vec InstanceRunSlice;
  num_steps : nat64;
};
type MatchStatus = variant { CANCELLED; OPEN; RUNNING; EXPIRED; FINISHED };
type Nas1Collection = record {
  states : vec text;
  sfx_sets : vec vec record { text; GameSfx };
  assets_canister_id : principal;
  version : float32;
  assets_url : text;
  skills : vec text;
};
type Nas1Token = record {
  xp : nat64;
  height : float32;
  model : text;
  image_url : text;
  traits : vec text;
  name : text;
  num_hidden_layers : nat64;
  extra : vec record { text; Nas1Value };
  model_url : text;
  epsilon : float32;
  radius : float32;
  hidden_layers_weights_size : vec nat64;
  sfx_set : nat64;
  steps_per_thought : nat64;
};
type Nas1Value = variant {
  Int : int;
  Map : HashMap;
  Nat : nat;
  Blob : vec nat8;
  Text : text;
  Double : float64;
  Float : float32;
  Array : vec Nas1Value;
};
type NftCollectionMetadata = record {
  std : NftStandard;
  desc : text;
  logo : text;
  name : text;
  nas1 : Nas1Collection;
};
type NftCollectionRequest = record {
  std : NftStandard;
  canister_id : principal;
};
type NftCollectionResponse = record {
  id : principal;
  active : bool;
  meta : NftCollectionMetadata;
  banned : bool;
};
type NftStandard = variant { ICRC7 };
type Pagination = record { offset : nat32; limit : nat32 };
type Result = variant { Ok : GameResponse; Err : text };
type Result_1 = variant { Ok : vec GameResponse; Err : text };
type Result_10 = variant { Ok : vec NftCollectionResponse; Err : text };
type Result_11 = variant { Ok : UserResponse; Err : text };
type Result_2 = variant { Ok : GameEndCredits; Err : text };
type Result_3 = variant { Ok : vec record { principal; float32 }; Err : text };
type Result_4 = variant { Ok : MatchResponse; Err : text };
type Result_5 = variant { Ok : vec MatchResponse; Err : text };
type Result_6 = variant { Ok : InstanceAssetsResponse; Err : text };
type Result_7 = variant { Ok : InstanceStepsResponse; Err : text };
type Result_8 = variant { Ok; Err : text };
type Result_9 = variant { Ok : NftCollectionResponse; Err : text };
type StaffRequest = record { role : StaffRole };
type StaffRole = variant { Member; Admin; Contributor };
type UserKindRequest = variant {
  Staff : StaffRequest;
  Player : record {};
  Developer : DeveloperRequest;
  Moderator : record {};
};
type UserNftRequest = record { token_id : nat; collection_id : principal };
type UserNftResponse = record {
  token_id : nat;
  data : Nas1Token;
  collection_id : principal;
};
type UserNftsRequest = record { nfts : vec UserNftRequest };
type UserRequest = record {
  kind : UserKindRequest;
  name : opt text;
  nick : text;
  email : opt text;
};
type UserResponse = record {
  id : principal;
  updated_at : opt nat64;
  active : bool;
  kind : UserKindRequest;
  name : opt text;
  nfts : vec UserNftResponse;
  nick : text;
  banned : bool;
  created_at : nat64;
  email : opt text;
};
service : (InitArg) -> {
  game_create : (GameRequest) -> (Result);
  game_find_active : (Pagination) -> (Result_1) query;
  game_find_all : (Pagination) -> (Result_1) query;
  game_find_by_id : (text) -> (Result) query;
  game_get_end_credits : (text) -> (Result_2) composite_query;
  game_get_leaderboard : (text, nat32) -> (Result_3) query;
  game_update : (text, GameRequest) -> (Result);
  match_create : (MatchRequest) -> (Result_4);
  match_find_all : (Pagination) -> (Result_5) query;
  match_find_by_game : (text, Pagination) -> (Result_5) query;
  match_find_by_id : (text) -> (Result_4) query;
  match_find_open : (Pagination) -> (Result_5) query;
  match_get_assets : (text) -> (Result_6) composite_query;
  match_get_steps : (text, Pagination) -> (Result_7) composite_query;
  match_join : (MatchJoinRequest) -> (Result_8);
  nft_col_create : (NftCollectionRequest) -> (Result_9);
  nft_col_find_active : (Pagination) -> (Result_10) query;
  nft_col_find_all : (Pagination) -> (Result_10) query;
  nft_col_find_by_id : (principal) -> (Result_9) query;
  nft_col_update : (principal) -> (Result_9);
  user_create_player : (UserRequest) -> (Result_11);
  user_create_staff : (UserRequest) -> (Result_11);
  user_delete : (principal) -> (Result_8);
  user_find_by_id : (principal) -> (Result_11) query;
  user_find_matches : (principal, Pagination) -> (Result_5) query;
  user_find_me : () -> (Result_11) query;
  user_update : (principal, UserRequest) -> (Result_11);
  user_update_nfts : (principal, UserNftsRequest) -> (Result_11);
}
